<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PREDICT — Avan data portal</title>
  <style>
    :root {
      --brand-primary: #2A4765;
      --brand-secondary: #73A790;
      --brand-accent: #D7B17C;
      --text: #222;
      --muted: #666;
      --bg: #fff;
      --soft: #f6f8fa;
      --border: #e1e4e8;
      --chip-bg: #eef6ff;
      --chip-border: #cfe2ff;
    }
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; margin:0; color:var(--text); background:var(--bg); }
    header { background: var(--brand-primary); color: white; padding: 1.5rem 0; }
    header .container { max-width: 1200px; margin: 0 auto; padding: 0 1rem; }
    h1 { margin: 0; font-weight: 700; letter-spacing: 0.3px; }
    .subtitle { margin-top: 0.25rem; color: #dfe7f2; }
    main { max-width: 1200px; margin: 1.25rem auto; padding: 0 1rem 3rem; }

    .introduction { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 1rem; margin: 1rem 0 1.25rem; }
    .introduction h1, .introduction h2, .introduction h3 { color: var(--brand-primary); }

    .dataset-card { border: 1px solid var(--border); border-radius: 10px; background: var(--soft); margin-bottom: 1.25rem; overflow: hidden; }
    .dataset-header { padding: 1rem 1rem 0.75rem; border-bottom: 1px solid var(--border); background: #fff; }
    .dataset-title { margin: 0; color: var(--brand-primary); }
    .dataset-subtitle { margin: 0.2rem 0 0.4rem; color: var(--muted); font-size: 0.95rem; }
    .dataset-info { font-size: 0.95rem; color: #333; }
    .dataset-info p { margin: 0.25rem 0; }
    .dataset-info code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; background: #f1f3f5; padding: 0 .25rem; border-radius: 4px; }

    .dataset-toggle-wrap { padding: 0.8rem 1rem; background: var(--soft); border-bottom: 1px solid var(--border); }
    .dataset-body.is-collapsed { display: none; }

    .controls { display: flex; gap: 0.75rem; align-items: center; padding: 0.8rem 1rem; background: var(--soft); border-bottom: 1px solid var(--border); }
    .controls input[type="search"], .controls select { padding: 0.55rem 0.7rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.95rem; background: #fff; }
    .controls input[type="search"] { flex: 1; }
    .controls .info { color: var(--muted); font-size: 0.9rem; }

    .table-wrap { overflow-x: auto; background:#fff; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    thead th { text-align: left; font-weight: 600; font-size: 0.9rem; color: var(--muted); padding: 0.6rem 0.7rem; border-bottom: 1px solid var(--border); background: #fafbfc; }
    tbody td { padding: 0.6rem 0.7rem; border-bottom: 1px solid var(--border); vertical-align: top; }
    tbody tr:hover { background: #fcfcfd; }
    .var-label { font-weight: 600; }
    .var-notes-preview { color: var(--muted); font-size: 0.9rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; margin-bottom: 0.25rem; }
    .var-notes-full { color: var(--muted); font-size: 0.9rem; margin-top: 0.5rem; white-space: pre-wrap; word-break: break-word; }
    .var-notes-toggle { background: none; border: none; color: var(--brand-primary); cursor: pointer; font-size: 0.9rem; padding: 0; margin-top: 0.25rem; text-decoration: underline; }
    .var-notes-toggle:hover { text-decoration: none; font-weight: 600; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; font-size: 0.9rem; }

    .chips { display: flex; flex-wrap: wrap; gap: 4px; }
    .chip { display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--chip-border); background: var(--chip-bg); font-size: 12px; color: #0f3b74; }

    .cart { position: sticky; top: 0; z-index: 2; background: #fff; border-bottom: 1px solid var(--border); }
    .cart .container { max-width: 1200px; margin: 0 auto; padding: 0.5rem 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; }
    .tag { background: var(--soft); border: 1px solid var(--border); border-radius: 999px; padding: 0.25rem 0.6rem; font-size: 0.85rem; }
    .btn { appearance: none; background: var(--brand-primary); color:#fff; border: none; border-radius: 6px; padding: 0.5rem 0.8rem; cursor: pointer; }
    .btn.secondary { background: var(--brand-secondary); }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; }

    /* Admonition styles */
    .admonition { margin: 1rem 0; padding: 0.8rem 1rem; border-left: 4px solid var(--border); border-radius: 6px; background: var(--soft); }
    .admonition.note { border-left-color: #2196F3; background: #E3F2FD; }
    .admonition.warning { border-left-color: #FF9800; background: #FFF3E0; }
    .admonition.danger { border-left-color: #F44336; background: #FFEBEE; }
    .admonition.tip { border-left-color: #4CAF50; background: #E8F5E9; }
    .admonition.info { border-left-color: #00BCD4; background: #E0F2F1; }
    .admonition.success { border-left-color: #4CAF50; background: #E8F5E9; }
    .admonition.bug { border-left-color: #F44336; background: #FFEBEE; }
    .admonition.example { border-left-color: #9C27B0; background: #F3E5F5; }
    .admonition.quote { border-left-color: #777; background: #f5f5f5; font-style: italic; }
    .admonition > :first-child { margin-top: 0; }
    .admonition > :last-child { margin-bottom: 0; }
    .admonition-title { font-weight: 700; margin-bottom: 0.5rem; }

    footer { max-width: 1200px; margin: 2rem auto; padding: 0 1rem 3rem; color: var(--muted); font-size: 0.9rem; }
    footer details { cursor: pointer; }
    footer details summary { user-select: none; font-weight: 600; }
    footer details summary:hover { color: var(--text); }
    footer details[open] summary { margin-bottom: 0.5rem; }
    footer pre { background: var(--soft); border: 1px solid var(--border); border-radius: 6px; padding: 0.8rem; overflow-x: auto; }
    @media(max-width:640px){ /* compact layout adjustments */ }
    /* Sidebar TOC styles */
    .app-layout { display: flex; gap: 1rem; align-items: flex-start; }
    .content { flex: 1; }
    .toc { width: 260px; position: sticky; top: 5.5rem; padding-left: 1rem; max-height: calc(100vh - 7rem); overflow: auto; border-left: 1px solid var(--border); }
    .toc h3 { margin: 0 0 0.5rem 0; font-size: 0.95rem; color: var(--brand-primary); }
    .toc ul { list-style: none; padding: 0; margin: 0; }
    .toc li { margin: 0.25rem 0; }
    .toc a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
    .toc a.active { color: var(--brand-primary); font-weight: 700; }
    @media(max-width:900px){ .toc { display: none; } }
    .site-footer { background: #000; color: #fff; padding: 2rem 1rem; }
    .site-footer a { color: #fff; text-decoration: underline; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <h1 style="margin:0">PREDICT</h1>
      <div class="subtitle">Avan data portal</div>
    </div>
  </header>

  <div class="cart">
      <div class="container">
      <strong>Selected variables:</strong>
      <span id="cart-count" class="tag">0</span>
      <button id="download-csv" class="btn" disabled>Download CSV</button>
      <button id="clear-selection" class="btn secondary" disabled>Clear</button>
      <span class="hide-sm" style="color:var(--muted)">Selections persist during this session only.</span>
      
    </div>
  </div>

  <main>
    {% if intro_html %}
    <section class="introduction">
      {{ intro_html | safe }}
    </section>
    {% endif %}

    <div class="app-layout">
      <div id="app" class="content"></div>
      <aside id="sidebar-toc" class="toc" aria-label="Datasets Table of Contents">
        <h3>Contents</h3>
        <ul></ul>
      </aside>
    </div>
  </main>

  <script id="dataset-json" type="application/json">{{ data_json | safe }}</script>

  <script>
  (function () {
    "use strict";

    /* ── Constants ──────────────────────────────────────────── */

    /** CSS selectors used throughout the application. */
    const SEL = {
      datasetJson: "#dataset-json",
      app: "#app",
      sidebarToc: "#sidebar-toc",
      cartCount: "#cart-count",
      downloadCsv: "#download-csv",
      clearSelection: "#clear-selection",
      cart: ".cart",
      toggleAll: '[data-action="toggle-all"]',
      filterCat: 'select[data-role="filterCat"]',
      search: 'input[type="search"]',
      notesPreview: ".var-notes-preview",
      notesToggle: ".var-notes-toggle",
      chip: ".chip[data-cat]",
    };

    /** CSS class names toggled by JS. */
    const CLS = {
      collapsed: "is-collapsed",
      active: "active",
    };

    /** UI label strings. */
    const TEXT = {
      showVars: "Show variables",
      hideVars: "Hide variables",
      more: "More\u2026",
      less: "Less",
    };

    /* ── State ──────────────────────────────────────────────── */

    const state = { datasets: [], selected: new Map() };

    /* ── DOM helpers ────────────────────────────────────────── */

    const $ = (sel, root = document) => root.querySelector(sel);
    const $all = (sel, root = document) =>
      Array.from(root.querySelectorAll(sel));

    /* ── Pure utilities ─────────────────────────────────────── */

    /** Parse the embedded JSON data blob. */
    function parseData() {
      const el = $(SEL.datasetJson);
      if (!el) return [];
      try {
        return JSON.parse(el.textContent.trim()) || [];
      } catch {
        return [];
      }
    }

    /** Escape a value for safe insertion into HTML. */
    function escapeHTML(s) {
      if (s == null) return "";
      return String(s)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    /** Escape a value for inclusion in a CSV cell. */
    function csvEscape(v) {
      if (v == null) return "";
      const s = String(v).replace(/\r?\n/g, " ");
      return s.includes(",") || s.includes('"')
        ? '"' + s.replace(/"/g, '""') + '"'
        : s;
    }

    /* ── Inline Markdown ────────────────────────────────────── */

    /**
     * Convert lightweight inline Markdown to HTML.
     *
     * Supports: [text](url), <url>, `code`, **strong**, *em*,
     * __strong__, _em_, ~~del~~, and auto-linking bare URLs.
     */
    function markdownToInlineHtml(input) {
      if (input == null) return "";
      let html = String(input);

      // Angle-bracket URLs: <https://…>
      html = html.replace(
        /<(https?:\/\/[^\s>]+)>/g,
        (_, url) =>
          '<a href="' + url + '" target="_blank" rel="noopener">' +
          escapeHTML(url) + "</a>"
      );

      // Markdown links: [text](url)
      html = html.replace(
        /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
        (_, text, url) =>
          '<a href="' + url + '" target="_blank" rel="noopener">' +
          escapeHTML(text) + "</a>"
      );

      // Inline code
      html = html.replace(
        /`([^`]+)`/g,
        (_, code) => "<code>" + escapeHTML(code) + "</code>"
      );

      // Strong (** and __), then emphasis (* and _), then del
      html = html.replace(
        /\*\*(?=\S)(.+?)(?<=\S)\*\*/g,
        "<strong>$1</strong>"
      );
      html = html.replace(
        /__(?=\S)(.+?)(?<=\S)__/g,
        "<strong>$1</strong>"
      );
      html = html.replace(
        /(?<!\*)\*(?=\S)(.+?)(?<=\S)(?<!\*)\*/g,
        "<em>$1</em>"
      );
      html = html.replace(
        /_(?=\S)(.+?)(?<=\S)_/g,
        "<em>$1</em>"
      );
      html = html.replace(
        /~~(?=\S)(.+?)(?<=\S)~~/g,
        "<del>$1</del>"
      );

      // Auto-link bare URLs not already inside a tag
      html = html.replace(
        /(^|[\s(>])((https?:\/\/[^\s<>"')]+))(?=[\s<)"']|$)/g,
        (_, pre, url) =>
          pre + '<a href="' + url +
          '" target="_blank" rel="noopener">' + url + "</a>"
      );

      return html;
    }

    /* ── Notes toggle ─────────────────────────────────────────
     *
     * Single implementation used by both the server-flagged
     * path (notes_is_long) and the deferred-measurement
     * fallback.  The guard at the top makes it idempotent.
     * ──────────────────────────────────────────────────────── */

    /**
     * Attach an expand / collapse toggle to a notes preview.
     *
     * Idempotent: skips if a toggle button already exists in
     * the same container.
     */
    function createNotesToggle(previewDiv, fullText) {
      const container = previewDiv.parentElement;
      if (container.querySelector(SEL.notesToggle)) return;

      previewDiv.style.display = "-webkit-box";

      const fullDiv = document.createElement("div");
      fullDiv.className = "var-notes-full";
      fullDiv.style.display = "none";
      fullDiv.textContent = fullText || "";

      const btn = document.createElement("button");
      btn.className = "var-notes-toggle";
      btn.textContent = TEXT.more;

      let expanded = false;
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        expanded = !expanded;
        previewDiv.style.display = expanded
          ? "none"
          : "-webkit-box";
        fullDiv.style.display = expanded ? "block" : "none";
        btn.textContent = expanded ? TEXT.less : TEXT.more;
      });

      container.appendChild(fullDiv);
      container.appendChild(btn);
    }

    /**
     * Scan all visible previews and add toggles where the text
     * is visually clamped (overflow detected).
     */
    function measureAndAddToggles() {
      requestAnimationFrame(() => {
        $all(SEL.notesPreview).forEach((el) => {
          if (el.scrollHeight > el.clientHeight + 1) {
            createNotesToggle(
              el,
              el.dataset.fullText || el.textContent
            );
          }
        });
      });
    }

    /* ── Data helpers ───────────────────────────────────────── */

    function toCSVRecord(ds, v) {
      return {
        yaml_file: v._source_yaml || "unknown",
        variable_name: v.name || "",
        notes: v.notes || "",
      };
    }

    /** Return sorted [category, count] pairs for a dataset. */
    function computeCategoryCounts(ds) {
      const counts = new Map();
      const allVars = ds.var_map_all || ds.var_map || {};
      for (const v of Object.values(allVars)) {
        for (const c of v.categories || []) {
          counts.set(c, (counts.get(c) || 0) + 1);
        }
      }
      return Array.from(counts.entries()).sort(
        (a, b) => a[0].localeCompare(b[0])
      );
    }

    /* ── Selection helpers ──────────────────────────────────── */

    function isGroupFullySelected(ds, group) {
      if (group.csv_expand === "group") {
        return state.selected.has(ds.id + "::" + group.name);
      }
      return (group.members || []).every(
        (name) => state.selected.has(ds.id + "::" + name)
      );
    }

    function selectGroup(ds, group) {
      if (group.csv_expand === "group") {
        state.selected.set(
          ds.id + "::" + group.name,
          toCSVRecord(ds, group)
        );
        return;
      }
      const vars = ds.var_map_all || ds.var_map || {};
      (group.members || []).forEach((name) => {
        const leaf = vars[name];
        if (leaf) {
          state.selected.set(
            ds.id + "::" + name,
            toCSVRecord(ds, leaf)
          );
        }
      });
    }

    function deselectGroup(ds, group) {
      if (group.csv_expand === "group") {
        state.selected.delete(ds.id + "::" + group.name);
        return;
      }
      (group.members || []).forEach(
        (name) => state.selected.delete(ds.id + "::" + name)
      );
    }

    /* ── Rendering: helpers ─────────────────────────────────── */

    /** Build HTML for a dataset's descriptive info block. */
    function buildInfoHTML(ds) {
      if (ds.info_html && String(ds.info_html).trim()) {
        return (
          '<div class="dataset-info">' +
          ds.info_html +
          "</div>"
        );
      }
      if (Array.isArray(ds.info) && ds.info.length) {
        const paras = ds.info
          .map((p) => "<p>" + markdownToInlineHtml(p) + "</p>")
          .join("");
        return (
          '<div class="dataset-info">' + paras + "</div>"
        );
      }
      return "";
    }

    /** Populate category <option>s in a <select> element. */
    function populateCategoryDropdown(ddl, ds) {
      for (const [cat] of computeCategoryCounts(ds)) {
        const opt = document.createElement("option");
        opt.value = cat;
        opt.textContent = cat;
        ddl.appendChild(opt);
      }
    }

    /** Wire up the checkbox on a variable row. */
    function attachRowCheckbox(tr, ds, v) {
      const key = tr.dataset.key;
      const cb = tr.querySelector('input[type="checkbox"]');
      cb.checked = v.is_group
        ? isGroupFullySelected(ds, v)
        : state.selected.has(key);

      cb.addEventListener("change", () => {
        if (v.is_group) {
          if (cb.checked) selectGroup(ds, v);
          else deselectGroup(ds, v);
        } else {
          if (cb.checked) {
            state.selected.set(key, toCSVRecord(ds, v));
          } else {
            state.selected.delete(key);
          }
        }
        updateCartUI();

        // Refresh group checkboxes in the same dataset
        $all("tbody tr", tr.closest("section")).forEach(
          (row) => {
            const vv = (ds._byRow || {})[row.dataset.key];
            if (vv && vv.is_group) {
              const c = row.querySelector(
                'input[type="checkbox"]'
              );
              c.checked = isGroupFullySelected(ds, vv);
            }
          }
        );
      });
    }

    /** Make category chips clickable filters. */
    function attachCategoryChipHandlers(tr, ds) {
      tr.querySelectorAll(SEL.chip).forEach((ch) => {
        ch.style.cursor = "pointer";
        ch.addEventListener("click", () => {
          const sectionEl = tr.closest("section");
          if (!sectionEl) return;
          const ddl = sectionEl.querySelector(SEL.filterCat);
          if (ddl) ddl.value = ch.dataset.cat;
          applyFilter(sectionEl, ds);
        });
        ch.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            ch.click();
          }
        });
      });
    }

    /* ── Rendering: row ─────────────────────────────────────── */

    /** Create a <tr> for a single variable or group. */
    function renderRow(ds, v) {
      const tr = document.createElement("tr");
      const key = ds.id + "::" + v.name;
      tr.dataset.key = key;

      const labelText = v.is_group
        ? v.label + " (" + (v.members || []).length + " fields)"
        : v.label || v.name;

      const chipsHTML = (v.categories || [])
        .map(
          (c) =>
            '<span class="chip" data-cat="' +
            escapeHTML(c) +
            '" role="button" tabindex="0" title="Filter by ' +
            escapeHTML(c) + '">' +
            escapeHTML(c) +
            "</span>"
        )
        .join("");

      tr.innerHTML =
        '<td><input type="checkbox" aria-label="Select ' +
        escapeHTML(labelText) + '"></td>' +
        "<td>" +
        '<div class="var-label">' +
        escapeHTML(labelText) + "</div>" +
        '<div class="var-notes-container"></div>' +
        "</td>" +
        '<td class="mono hide-sm">' +
        escapeHTML(v.name) + "</td>" +
        '<td class="mono hide-sm">' +
        escapeHTML(v.source || "") + "</td>" +
        '<td class="hide-sm">' +
        escapeHTML(v.type || "") + "</td>" +
        '<td class="hide-sm"><div class="chips">' +
        chipsHTML + "</div></td>";

      // Render notes with optional expand / collapse toggle
      if (v.notes) {
        const container =
          tr.querySelector(".var-notes-container");
        const previewDiv = document.createElement("div");
        previewDiv.className = "var-notes-preview";
        previewDiv.textContent =
          v.notes_preview != null
            ? v.notes_preview
            : v.notes;
        previewDiv.dataset.fullText = v.notes;
        container.appendChild(previewDiv);

        if (v.notes_is_long) {
          createNotesToggle(previewDiv, v.notes);
        }
      }

      attachCategoryChipHandlers(tr, ds);
      attachRowCheckbox(tr, ds, v);

      ds._byRow = ds._byRow || {};
      ds._byRow[key] = v;
      return tr;
    }

    /* ── Rendering: dataset card ──────────────────────────────
     *
     * Extracted from the former monolithic render() so each
     * dataset's DOM construction and event wiring is isolated.
     * ──────────────────────────────────────────────────────── */

    /** Build a complete dataset card with header, toggle, and
     *  variable table. */
    function renderDatasetCard(ds) {
      const section = document.createElement("section");
      section.className = "dataset-card";
      section.dataset.datasetId = ds.id;
      section.id = ds.id;

      // ── Header ──
      const header = document.createElement("div");
      header.className = "dataset-header";
      header.innerHTML =
        '<h2 class="dataset-title">' +
        escapeHTML(ds.title || ds.id) + "</h2>" +
        (ds.subtitle
          ? '<div class="dataset-subtitle">' +
            escapeHTML(ds.subtitle) + "</div>"
          : "") +
        buildInfoHTML(ds);
      section.appendChild(header);

      // ── Collapse / expand toggle ──
      const toggleWrap = document.createElement("div");
      toggleWrap.className = "dataset-toggle-wrap";

      const toggleBtn = document.createElement("button");
      toggleBtn.className = "btn dataset-toggle";
      toggleBtn.setAttribute("data-role", "toggle-dataset");
      toggleBtn.setAttribute("data-dataset-id", ds.id);
      toggleBtn.setAttribute("aria-expanded", "false");
      toggleBtn.textContent = TEXT.showVars;
      toggleWrap.appendChild(toggleBtn);
      section.appendChild(toggleWrap);

      // ── Body (collapsed by default) ──
      const body = document.createElement("div");
      body.className = "dataset-body " + CLS.collapsed;
      body.id = "body-" + ds.id;

      // Controls row
      const controls = document.createElement("div");
      controls.className = "controls";
      controls.innerHTML =
        '<input type="search" ' +
        'placeholder="Search\u2026 (label, variable, notes)" ' +
        'aria-label="Search variables">' +
        '<select data-role="filterCat" ' +
        'aria-label="Filter by category">' +
        '<option value="">All categories</option>' +
        "</select>" +
        '<div class="info">' +
        (ds.variables || []).length + " items</div>";
      body.appendChild(controls);

      populateCategoryDropdown(
        controls.querySelector(SEL.filterCat),
        ds
      );

      // Variable table
      const tableWrap = document.createElement("div");
      tableWrap.className = "table-wrap";
      tableWrap.innerHTML =
        "<table><thead><tr>" +
        '<th style="width:2rem">' +
        '<input type="checkbox" data-action="toggle-all">' +
        "</th>" +
        "<th>Label</th>" +
        '<th class="hide-sm">Variable name</th>' +
        '<th class="hide-sm">Source variable name</th>' +
        '<th class="hide-sm">Type</th>' +
        '<th class="hide-sm">Categories</th>' +
        "</tr></thead><tbody></tbody></table>";
      body.appendChild(tableWrap);

      const tbody = tableWrap.querySelector("tbody");
      (ds.variables || []).forEach((v) => {
        v._search = [
          v.label, v.name, v.notes, ...(v.members || []),
        ]
          .filter(Boolean)
          .join(" ");
        tbody.appendChild(renderRow(ds, v));
      });

      section.appendChild(body);

      // ── Event wiring ──
      controls
        .querySelector(SEL.search)
        .addEventListener("input", () =>
          applyFilter(section, ds)
        );

      controls
        .querySelector(SEL.filterCat)
        .addEventListener("change", () =>
          applyFilter(section, ds)
        );

      body
        .querySelector(SEL.toggleAll)
        .addEventListener("change", (e) => {
          $all("tbody tr", body)
            .filter((r) => r.style.display !== "none")
            .forEach((r) => {
              const cb =
                r.querySelector('input[type="checkbox"]');
              cb.checked = e.target.checked;
              cb.dispatchEvent(new Event("change"));
            });
        });

      toggleBtn.addEventListener("click", () => {
        const wasExpanded =
          toggleBtn.getAttribute("aria-expanded") === "true";
        const next = !wasExpanded;
        toggleBtn.setAttribute(
          "aria-expanded", String(next)
        );
        toggleBtn.textContent = next
          ? TEXT.hideVars
          : TEXT.showVars;
        body.classList.toggle(CLS.collapsed, !next);
        // Deferred measurement after expand to catch clamped
        // notes that were invisible while collapsed.
        if (next) measureAndAddToggles();
      });

      return section;
    }

    /* ── Rendering: main ──────────────────────────────────── */

    function render() {
      const app = $(SEL.app);
      app.innerHTML = "";

      const sections = state.sections || [
        { heading: "", datasets: state.datasets || [] },
      ];

      sections.forEach((sec) => {
        if (sec.heading) {
          const h = document.createElement("h2");
          h.textContent = sec.heading;
          h.style.color = "var(--brand-primary)";
          h.style.marginTop = "1.25rem";
          app.appendChild(h);
        }
        (sec.datasets || []).forEach((ds) => {
          app.appendChild(renderDatasetCard(ds));
        });
      });

      measureAndAddToggles();
      updateCartUI();
    }

    /* ── Filtering ────────────────────────────────────────── */

    function applyFilter(section, ds) {
      const q = section
        .querySelector(SEL.search)
        .value.trim()
        .toLowerCase();
      const cat = section
        .querySelector(SEL.filterCat).value;

      $all("tbody tr", section).forEach((r) => {
        const v = (ds._byRow || {})[r.dataset.key];
        const blob = (v?._search || "").toLowerCase();
        const matchesText = !q || blob.includes(q);
        const matchesCat =
          !cat ||
          (v.categories || []).includes(cat) ||
          (v.is_group &&
            (v.members || []).some(
              (name) =>
                (ds.var_map[name] || {})
                  .categories?.includes(cat)
            ));
        r.style.display =
          matchesText && matchesCat ? "" : "none";
      });

      section.querySelector(SEL.toggleAll).checked = false;
    }

    /* ── Cart UI ──────────────────────────────────────────── */

    function updateCartUI() {
      const n = state.selected.size;
      $(SEL.cartCount).textContent = String(n);
      $(SEL.downloadCsv).disabled = n === 0;
      $(SEL.clearSelection).disabled = n === 0;
    }

    function downloadCSV() {
      const rows = Array.from(state.selected.values());
      if (!rows.length) return;

      const headers = ["yaml_file", "variable_name", "notes"];
      const csv = [headers.join(",")]
        .concat(
          rows.map((r) =>
            headers.map((h) => csvEscape(r[h] ?? ""))
              .join(",")
          )
        )
        .join("\n");

      const blob = new Blob([csv], {
        type: "text/csv;charset=utf-8;",
      });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "predict_variables.csv";
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    function clearSelection() {
      state.selected.clear();
      $all('tbody input[type="checkbox"]').forEach(
        (cb) => (cb.checked = false)
      );
      updateCartUI();
    }

    /* ── Sidebar TOC ──────────────────────────────────────── */

    /** Build the sidebar table-of-contents and wire up scroll
     *  highlighting via IntersectionObserver. */
    function initSidebarToc(dsIndex) {
      const toc = $(SEL.sidebarToc);
      if (!toc) return;
      const tocList = toc.querySelector("ul");

      // Suppresses observer during smooth-scroll animation
      let ignoreObserver = false;

      function jumpToDataset(id) {
        const el = document.getElementById(id);
        if (!el) return;

        const topBar = $(SEL.cart);
        const offset = topBar
          ? Math.ceil(
              topBar.getBoundingClientRect().height
            ) + 8
          : 16;

        const maxScroll = Math.max(
          0,
          document.documentElement.scrollHeight -
            window.innerHeight
        );
        const target = Math.max(
          0,
          Math.min(
            el.getBoundingClientRect().top +
              window.scrollY -
              offset,
            maxScroll
          )
        );

        ignoreObserver = true;
        setTimeout(() => {
          ignoreObserver = false;
        }, 700);

        window.scrollTo({ top: target, behavior: "smooth" });

        // Immediately highlight the clicked link
        toc
          .querySelectorAll("a")
          .forEach((x) => x.classList.remove(CLS.active));
        const link = toc.querySelector(
          'a[data-target-id="' + id + '"]'
        );
        if (link) link.classList.add(CLS.active);
      }

      // Populate TOC links
      dsIndex.forEach((d) => {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = "#" + d.id;
        a.textContent = d.title || d.id;
        a.dataset.targetId = d.id;
        a.addEventListener("click", (ev) => {
          ev.preventDefault();
          jumpToDataset(d.id);
        });
        li.appendChild(a);
        tocList.appendChild(li);
      });

      // Highlight active section via IntersectionObserver
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (ignoreObserver) return;
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const id = entry.target.id;
              toc
                .querySelectorAll("a")
                .forEach((x) =>
                  x.classList.remove(CLS.active)
                );
              const link = toc.querySelector(
                'a[data-target-id="' + id + '"]'
              );
              if (link) link.classList.add(CLS.active);
            });
          },
          {
            root: null,
            rootMargin: "-20% 0px -60% 0px",
            threshold: 0,
          }
        );
        dsIndex.forEach((d) => {
          const el = document.getElementById(d.id);
          if (el) observer.observe(el);
        });
      }
    }

    /* ── Bootstrap ────────────────────────────────────────── */

    function init() {
      const parsed = parseData();
      let sections = [];
      let flat = [];

      if (
        Array.isArray(parsed) &&
        parsed.length &&
        parsed[0] &&
        typeof parsed[0] === "object" &&
        Array.isArray(parsed[0].datasets)
      ) {
        sections = parsed;
        parsed.forEach((sec) => {
          (sec.datasets || []).forEach((ds) =>
            flat.push(ds)
          );
        });
      } else {
        const dsArray = Array.isArray(parsed)
          ? parsed
          : [];
        sections = [{ heading: "", datasets: dsArray }];
        flat = dsArray;
      }

      state.sections = sections;
      state.datasets = flat;
      state.datasets.forEach((ds) => {
        ds.var_map = ds.var_map || {};
      });

      render();

      $(SEL.downloadCsv).addEventListener(
        "click", downloadCSV
      );
      $(SEL.clearSelection).addEventListener(
        "click", clearSelection
      );

      initSidebarToc(
        state.datasets.map((d) => ({
          id: d.id,
          title: d.title || d.id,
        }))
      );
    }

    window.addEventListener("DOMContentLoaded", init);
  })();
  </script>

  <footer>
    <details style="color: var(--muted); font-size: 0.85rem; margin-top: 2rem;">
      <summary style="cursor: pointer; font-weight: 600; user-select: none;">Build info</summary>
      <div style="margin-top: 0.5rem;">
        {% if build_date %}
        <p style="margin: 0.25rem 0;"><strong>Build date:</strong> {{ build_date }}</p>
        {% endif %}
        {% if git_sha %}
        <p style="margin: 0.25rem 0;"><strong>Git SHA:</strong> <code style="font-family: monospace; background: var(--soft); padding: 0 0.25rem; border-radius: 4px;">{{ git_sha[:8] }}</code></p>
        {% endif %}
      </div>
    </details>
  </footer>

  {% if footer_html %}
  <div class="site-footer">
    <div class="container">{{ footer_html | safe }}</div>
  </div>
  {% endif %}

</body>
</html>
